{
  "source": "claude-code",
  "wire": "anthropic-messages",
  "model": "claude-opus-5",
  "note": "Hand-written permission-mode fixture: one file edit, one allowed command and one command the test judge denies, all inside the throwaway workspace (${WORKSPACE}). Used to compare bypass, accept-edits and ask modes. Claude commands use `node -e` writes because accept-edits auto-approves plain filesystem commands such as touch.",
  "turns": [
    {
      "user": {
        "text": "Update the workspace as requested.",
        "t_ms": 0
      },
      "events": [
        {
          "kind": "text",
          "t_ms": 10,
          "text": "Writing the note."
        },
        {
          "kind": "tool_call",
          "t_ms": 20,
          "call_id": "toolu_mode_01",
          "name": "Write",
          "input": {
            "file_path": "${WORKSPACE}/judge-edit.txt",
            "content": "edited by replay\n"
          }
        },
        {
          "kind": "tool_result",
          "t_ms": 30,
          "call_id": "toolu_mode_01",
          "output": ""
        },
        {
          "kind": "tool_call",
          "t_ms": 40,
          "call_id": "toolu_mode_02",
          "name": "Bash",
          "input": {
            "command": "node -e \"require('node:fs').writeFileSync('judge-allowed.txt', '')\"",
            "description": "Create allowed marker"
          }
        },
        {
          "kind": "tool_result",
          "t_ms": 50,
          "call_id": "toolu_mode_02",
          "output": ""
        },
        {
          "kind": "tool_call",
          "t_ms": 60,
          "call_id": "toolu_mode_03",
          "name": "Bash",
          "input": {
            "command": "node -e \"require('node:fs').writeFileSync('judge-denied.txt', '')\"",
            "description": "Create denied marker"
          }
        },
        {
          "kind": "tool_result",
          "t_ms": 70,
          "call_id": "toolu_mode_03",
          "output": ""
        },
        {
          "kind": "text",
          "t_ms": 80,
          "text": "Done."
        }
      ]
    }
  ]
}
